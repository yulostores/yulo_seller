# Copy to .env for LOCAL DEVELOPMENT only:  cp .env.example .env
#
# .env is gitignored and never reaches Vercel. Production values go in Vercel → Project
# Settings → Environment Variables. VITE_* values are inlined into the bundle at build time
# and are publicly readable — never put a secret here.

# Prefix for API requests. Leave blank in development to use the Vite dev proxy
# (vite.config.js). In production point it at the backend origin.
VITE_API_BASE=

# Dev-only: where the Vite proxy forwards /api and /health (e.g. http://localhost:3100 for
# the local test stack).
# VITE_PROXY_TARGET=
